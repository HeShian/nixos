// 布局：gaps / 预设宽度 / 阴影 / 焦点环。
// 颜色由 dms/colors.kdl（matugen 根据壁纸生成）在运行时覆盖。
layout {
    gaps 12

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
    }

    // 只保留焦点环，不额外画常驻边框
    border {
        off
    }

    shadow {
        on
        softness 20
        spread 2
        offset x=-4 y=-4
        color "rgba(0, 0, 0, 0.7)"
    }

    struts {
    }
}
