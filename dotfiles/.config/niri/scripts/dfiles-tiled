#!/usr/bin/env bash
# Mod+Alt+E：新开一个 Dux Files 窗口，并把它切到平铺布局。
#
# dfiles 的窗口默认被 niri 当成浮动窗口（windowrules.kdl 里还给它设了
# 897×543 的默认浮窗尺寸），所以打开后用 niri IPC 按窗口 id 切回平铺。
set -uo pipefail

ids() {
  niri msg --json windows 2>/dev/null |
    jq -r '.[] | select(.app_id == "dev.duxlabs.files") | .id' |
    sort
}

before=$(ids)
dfiles open --new-window >/dev/null 2>&1 &

new=
for _ in $(seq 1 60); do
  new=$(comm -13 <(printf '%s\n' "$before") <(ids) | tail -1)
  [ -n "$new" ] && break
  sleep 0.05
done

if [ -z "$new" ]; then
  exit 1
fi

niri msg action move-window-to-tiling --id "$new" >/dev/null 2>&1 || true
