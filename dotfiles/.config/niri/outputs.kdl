// 显示器配置 —— 这是“需要经常改”的部分：
// 分辨率 / 缩放 / 位置 / 刷新率都写在这里；保存后 niri 立即生效。
// 查看当前输出名称：niri msg outputs
//
// 这里保存默认值。Dux 的“显示”设置页写入 dms/outputs.kdl，后加载并覆盖相应设置。

output "eDP-1" {
    scale 1.25
}

// 外接显示器示例（按需取消注释并替换名称/分辨率）：
// output "HDMI-A-1" {
//     mode "1920x1080@60.000"
//     scale 1.0
//     position x=1920 y=0
// }
