// ┌──────────────────────────────────────────────────────────────────────────┐
// │ niri 主配置                                                                │
// │ 本文件由 home-manager 软链到 ~/.config/niri/config.kdl                     │
// │ 直接编辑保存即可，niri 会自动重载；DMS 生成的片段在 ~/.config/niri/dms/。  │
// └──────────────────────────────────────────────────────────────────────────┘

// 手写配置分片。生效顺序 = 文件顺序：同一设置后写的覆盖先写的。
// 手写块是默认值，DMS 运行期片段（下面的 dms/*）在其后，用户在 DMS 界面改的东西优先。
include "layout.kdl"
include "animations.kdl"
include "blur.kdl"
include "windowrules.kdl"
include "supertab.kdl"
include "binds.kdl"
include "outputs.kdl"

// 外观初值（光标），由 Home Manager 生成（ADR-0006）。放在 dms/cursor.kdl 之前，
// 让 DMS 光标设置页的改动能覆盖它。
include optional=true "appearance.kdl"

// DMS / matugen 运行时生成的片段（首次生成前不存在，用 optional 跳过）。
// 位置固定在手写块之后，理由逐条列在下面。
include optional=true "dms/binds.kdl"      // DMS 绑定补空位
include optional=true "dms/outputs.kdl"    // 显示设置页优先于手写 outputs.kdl
include optional=true "dms/colors.kdl"     // 只补颜色，手写块不设色值
include optional=true "dms/alttab.kdl"     // 只加 layer-rule / 键位
include optional=true "dms/cursor.kdl"     // 光标设置页优先于 appearance.kdl 的初值
include optional=true "dms/windowrules.kdl" // DMS 新建的窗口规则优先（见 windowrules.kdl 头部）
// overview 背景：把 DMS 的模糊壁纸层放进 niri 的 backdrop
include optional=true "dms/wpblur.kdl"

// 有意不 include 的两个片段：
//   dms/input.kdl    —— DMS 启动时按自身默认值写出（accel 0.0），会覆盖手写的 -0.15
//   dms/layout.kdl   —— 同上（gaps 4 / border 2 / 窗口圆角），会覆盖手写的 gaps 12 / border off
// 也就是说 DMS 的「输入」「布局」两页不会生效；改这两类设置请改本文件的 input 段与 layout.kdl。

// 截图保存位置（niri 自带截图 UI / Screenshot 键）
screenshot-path "~/Pictures/Screenshots/Niri-screenshots/%Y-%m-%d_%H-%M-%S.png"

// 由 niri 在 X11 客户端连接时启动。
xwayland-satellite {
    path "/run/current-system/sw/bin/xwayland-satellite"
}

// 会话环境变量不在这里写：唯一来源是 modules/_lib/session-env.nix，由 niri Aspect
// 写到 environment.sessionVariables（登录会话导出，niri 与 systemd 用户服务都能拿到）。
// 需要新增会话变量时改那张表，不要在这里加 environment {} 块。
//
// 图标主题也不在这里写 QS_ICON_THEME：Dux Shell 2.x 的 IconThemeService 在它存在时
// 会跳过系统主题探测，图标主题改由 GSettings（dconf）提供。

input {
    keyboard {
        repeat-delay 250
        repeat-rate 35
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-speed -0.15
        accel-profile "flat"
    }

    trackpoint {
    }
}

// 光标：值的来源在 modules/_lib/appearance.nix，分片由 Home Manager 生成（ADR-0006），
// include 在文件头部（见那里的注释），DMS 光标设置页优先。

// 启动时隐藏 Niri 自带的“Important Hotkeys”教程
hotkey-overlay {
    skip-at-startup
}

// 隐藏窗口自带标题栏，边框/圆角由 niri 绘制
prefer-no-csd

// 截图音效守护进程：快捷键先标记截图，剪贴板收到图片后播放快门声
spawn-at-startup "~/.config/niri/scripts/screenshot-sound.sh"

// 放宽焦点拦截，修复点击托盘程序无法聚焦的问题
debug {
    honor-xdg-activation-with-invalid-serial
}
