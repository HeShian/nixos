{
  # 应用与桌面环境的接线：celluloid 使用 mpv 配置、pywalfox 的原生消息宿主与兼容软链。
  # 这类「让某个应用跟着桌面一起变色/工作」的配置放这里，不要混进软件清单。
  den.aspects.desktop-app-integrations = {
    homeManager = { pkgs, config, ... }:
    let
      # Firefox 扩展 Pywalfox 的原生消息宿主清单。
      # path 必须是绝对路径：Firefox 直接 exec 它，不经过 shell/PATH。
      pywalfoxManifest =
        path:
        builtins.toJSON {
          name = "pywalfox";
          description = "Automatically theme your browser using the colors generated by Pywal";
          inherit path;
          type = "stdio";
          allowed_extensions = [ "pywalfox@frewacom.org" ];
        };
    in {
      dconf.settings."io/github/celluloid-player/celluloid" = {
        mpv-config-enable = true;
        mpv-config-file = "file://${config.xdg.configHome}/mpv/config";
      };

      # Pywalfox 原生消息宿主：Firefox 扩展靠它读取 ~/.cache/wal/colors.json
      # （该文件由 DMS 内置的 matugen 模板 pywalfox-colors.json 生成）。
      # Firefox 159 的 profile 根目录已迁到 ~/.config/mozilla（XDG 布局），
      # 原生消息清单也跟着走；旧 ~/.mozilla 再放一份，兼容还认旧路径的工具。
      home.file = {
        ".config/mozilla/native-messaging-hosts/pywalfox.json".text = pywalfoxManifest "${pkgs.pywalfox-native}/bin/pywalfox";
        ".mozilla/native-messaging-hosts/pywalfox.json".text = pywalfoxManifest "${pkgs.pywalfox-native}/bin/pywalfox";

        # pywalfox 2.9 只认 ~/.mozilla/firefox（或错误地猜 ~/.config/firefox）
        # 来读 profiles.ini、写 userChrome.css，给 XDG 目录做个兼容软链。
        ".mozilla/firefox".source =
          config.lib.file.mkOutOfStoreSymlink "${config.home.homeDirectory}/.config/mozilla/firefox";

      };
    };
  };
}
