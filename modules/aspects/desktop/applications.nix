{ inputs, ... }:
let
  # Firefox 扩展 Pywalfox 的原生消息宿主清单。
  # path 必须是绝对路径：Firefox 直接 exec 它，不经过 shell/PATH。
  pywalfoxManifest =
    path:
    builtins.toJSON {
      name = "pywalfox";
      description = "Automatically theme your browser using the colors generated by Pywal";
      inherit path;
      type = "stdio";
      allowed_extensions = [ "pywalfox@frewacom.org" ];
    };
in
{
  den.aspects.desktop-applications = {
    nixos = { lib, ... }: {
      nixpkgs.config.allowUnfreePredicate = pkg: builtins.elem (lib.getName pkg) [
        "chatgpt"
        "vscode"
        "obsidian"
        "feishu"
        "wemeet"
        "libwemeetwrap" # 腾讯会议的运行依赖
        "qq"
        "wechat"
        "steam"
        "steam-unwrapped"
        # NVIDIA 驱动组件（hardware.nvidia）
        "nvidia-x11"
        "nvidia-settings"
        "nvidia-modprobe"
        "nvidia-persistenced"
      ];

      programs.steam.enable = true;
    };

    homeManager = { pkgs, config, ... }:
    let
      zen = inputs.zen-browser.packages.${pkgs.stdenv.hostPlatform.system}.beta;
      zenDesktop = "${zen.meta.mainProgram}.desktop";
    in {
      home.packages = with pkgs; [
        # ── 浏览器 / 办公 / 通讯 ────────────────────────────────
        zen
        bitwarden-desktop
        chatgpt
        onlyoffice-desktopeditors
        obsidian
        vscode
        feishu
        wemeet
        qq
        wechat
        ayugram-desktop
        vesktop
        thunderbird

        # ── 游戏 ────────────────────────────────────────────────
        heroic
        lutris

        # ── 文件管理（Dux Files 由 programs.dux-files 安装，这里只留缩略图依赖） ──
        # dfiles 通过 freedesktop 缩略图器生成预览（bwrap 沙箱内执行）
        ffmpegthumbnailer
        poppler
        webp-pixbuf-loader
        libgsf
        gst_all_1.gst-plugins-base
        gst_all_1.gst-plugins-good
        gst_all_1.gst-libav
        gnome-keyring

        # ── 媒体 / 截图 / 剪贴板 ────────────────────────────────
        mpv
        celluloid
        go-musicfox
        kazumi
        imv
        satty
        pavucontrol
        wl-clipboard
        libnotify
        imagemagick
        jq
        fuzzel
        fzf
        slurp
        grim
        wl-screenrec

        # ── 系统 / 终端小工具 ───────────────────────────────────
        xprop
        procps
        fastfetch
        gdu
        timg
        pywalfox-native
        qt6Packages.qt6ct # DMS 的 Qt 主题后端（检测到 qt6ct 才会启用 Qt 配色）
        adw-gtk3
        bazaar # Flatpak 图形化软件商店（参考配置）
      ];

      dconf.settings."io/github/celluloid-player/celluloid" = {
        mpv-config-enable = true;
        mpv-config-file = "file://${config.xdg.configHome}/mpv/config";
      };

      # Pywalfox 原生消息宿主：Firefox 扩展靠它读取 ~/.cache/wal/colors.json
      # （该文件由 DMS 内置的 matugen 模板 pywalfox-colors.json 生成）。
      # Firefox 159 的 profile 根目录已迁到 ~/.config/mozilla（XDG 布局），
      # 原生消息清单也跟着走；旧 ~/.mozilla 再放一份，兼容还认旧路径的工具。
      home.file = {
        ".config/mozilla/native-messaging-hosts/pywalfox.json".text = pywalfoxManifest "${pkgs.pywalfox-native}/bin/pywalfox";
        ".mozilla/native-messaging-hosts/pywalfox.json".text = pywalfoxManifest "${pkgs.pywalfox-native}/bin/pywalfox";

        # pywalfox 2.9 只认 ~/.mozilla/firefox（或错误地猜 ~/.config/firefox）
        # 来读 profiles.ini、写 userChrome.css，给 XDG 目录做个兼容软链。
        ".mozilla/firefox".source =
          config.lib.file.mkOutOfStoreSymlink "${config.home.homeDirectory}/.config/mozilla/firefox";

      };

      xdg.mimeApps = {
        enable = true;
        defaultApplications = {
          "text/html" = [ zenDesktop ];
          "application/xhtml+xml" = [ zenDesktop ];
          "x-scheme-handler/http" = [ zenDesktop ];
          "x-scheme-handler/https" = [ zenDesktop ];

          "image/png" = [ "imv.desktop" ];
          "image/jpeg" = [ "imv.desktop" ];
          "image/gif" = [ "imv.desktop" ];
          "image/webp" = [ "imv.desktop" ];
          "image/bmp" = [ "imv.desktop" ];
          "image/tiff" = [ "imv.desktop" ];
          "image/svg+xml" = [ "imv.desktop" ];

          "video/mp4" = [ "mpv.desktop" ];
          "video/webm" = [ "mpv.desktop" ];
          "video/x-matroska" = [ "mpv.desktop" ];
          "video/avi" = [ "mpv.desktop" ];
          "video/quicktime" = [ "mpv.desktop" ];

          # ── 文件管理：Dux Files 接管目录、回收站、远程挂载与压缩包 ──
          "inode/directory" = [ "dev.duxlabs.files.desktop" ];
          "x-scheme-handler/trash" = [ "dev.duxlabs.files.desktop" ];
          "x-scheme-handler/sftp" = [ "dev.duxlabs.files.desktop" ];
          "x-scheme-handler/smb" = [ "dev.duxlabs.files.desktop" ];
          "application/zip" = [ "dev.duxlabs.files.desktop" ];
          "application/x-tar" = [ "dev.duxlabs.files.desktop" ];
          "application/gzip" = [ "dev.duxlabs.files.desktop" ];
          "application/x-compressed-tar" = [ "dev.duxlabs.files.desktop" ];
          "application/x-bzip2" = [ "dev.duxlabs.files.desktop" ];
          "application/x-bzip2-compressed-tar" = [ "dev.duxlabs.files.desktop" ];
          "application/x-xz" = [ "dev.duxlabs.files.desktop" ];
          "application/x-xz-compressed-tar" = [ "dev.duxlabs.files.desktop" ];
          "application/zstd" = [ "dev.duxlabs.files.desktop" ];
          "application/x-zstd-compressed-tar" = [ "dev.duxlabs.files.desktop" ];
          "application/x-lzma" = [ "dev.duxlabs.files.desktop" ];
          "application/x-lzma-compressed-tar" = [ "dev.duxlabs.files.desktop" ];
          "application/x-7z-compressed" = [ "dev.duxlabs.files.desktop" ];
          "application/vnd.rar" = [ "dev.duxlabs.files.desktop" ];
          "application/x-cpio" = [ "dev.duxlabs.files.desktop" ];

          # ── 日历：Dux Calendar（webcal 订阅与 .ics 文件） ──
          "text/calendar" = [ "dev.duxlabs.calendar.desktop" ];
          "text/x-vcalendar" = [ "dev.duxlabs.calendar.desktop" ];
          "application/ics" = [ "dev.duxlabs.calendar.desktop" ];
          "x-scheme-handler/webcal" = [ "dev.duxlabs.calendar.desktop" ];
          "x-scheme-handler/webcals" = [ "dev.duxlabs.calendar.desktop" ];

          # ── 文本：Dux 便签（dev.duxlabs.shell.notepad.desktop 由 dux-shell 提供） ──
          # 该桌面项就是 `dms ipc call notepad openFile %f`，NoDisplay 但仍然可作默认程序。
          "text/plain" = [ "dev.duxlabs.shell.notepad.desktop" ];
          "text/markdown" = [ "dev.duxlabs.shell.notepad.desktop" ];

          "application/json" = [ "code.desktop" ];
          "application/x-shellscript" = [ "code.desktop" ];
          "text/x-csrc" = [ "code.desktop" ];
        };
      };
    };
  };
}
