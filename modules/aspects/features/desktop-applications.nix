{ inputs, den, ... }:
{
  # 两台 Host 共用的应用集合：安装、默认关联与接线按关注点一起维护。
  den.aspects.desktop-applications = {
    includes = [
      (den.batteries.unfree [
        "chatgpt"
        "vscode"
        "obsidian"
        "feishu"
        "wemeet"
        "libwemeetwrap" # 腾讯会议的运行依赖
        "qq"
        "wechat"
        "steam"
        "steam-unwrapped"
      ])
    ];

    nixos = {
    imports = [ inputs.nix-flatpak.nixosModules.nix-flatpak ];

    services.flatpak = {
      enable = true;
      packages = [ "com.brave.Browser" ];
      remotes = [
        {
          name = "flathub";
          location = "https://dl.flathub.org/repo/flathub.flatpakrepo";
        }
      ];
    };

  programs.steam.enable = true;
};

    homeManager = { config, lib, pkgs, ... }: lib.mkMerge [
      {
        xdg.mimeApps.enable = true;

        # 无额外接线的应用，以及 Dotfile 脚本使用的桌面工具。
        home.packages = with pkgs; [
          bitwarden-desktop
          chatgpt
          onlyoffice-desktopeditors
          obsidian
          feishu
          wemeet
          qq
          wechat
          ayugram-desktop
          vesktop
          thunderbird
          heroic
          lutris
          gnome-keyring
          go-musicfox
          kazumi
          satty
          pavucontrol
          wl-clipboard
          libnotify
          imagemagick
          jq
          fuzzel
          fzf
          slurp
          grim
          wl-screenrec
          xprop
          procps
          fastfetch
          gdu
          timg
          bazaar
        ];
      }

      # 浏览器：同一份 Zen 包信息决定安装与默认桌面项。
      (let
        zen = inputs.zen-browser.packages.${pkgs.stdenv.hostPlatform.system}.beta;
        zenDesktop = "${zen.meta.mainProgram}.desktop";
        # Firefox 直接执行宿主程序，清单必须使用绝对路径。
        pywalfoxManifest = builtins.toJSON {
          name = "pywalfox";
          description = "Automatically theme your browser using the colors generated by Pywal";
          path = "${pkgs.pywalfox-native}/bin/pywalfox";
          type = "stdio";
          allowed_extensions = [ "pywalfox@frewacom.org" ];
        };
      in {
        home.packages = [ zen pkgs.pywalfox-native ];
        xdg.mimeApps.defaultApplications = {
          "text/html" = [ zenDesktop ];
          "application/xhtml+xml" = [ zenDesktop ];
          "x-scheme-handler/http" = [ zenDesktop ];
          "x-scheme-handler/https" = [ zenDesktop ];
        };

        # DMS 生成 ~/.cache/wal/colors.json；宿主供 Firefox 扩展读取。
        home.file = {
          # Firefox 的 XDG 路径，以及仍读取旧路径的工具。
          ".config/mozilla/native-messaging-hosts/pywalfox.json".text = pywalfoxManifest;
          ".mozilla/native-messaging-hosts/pywalfox.json".text = pywalfoxManifest;
          # pywalfox 2.9 从旧路径读取 profiles.ini、写入 userChrome.css。
          ".mozilla/firefox".source =
            config.lib.file.mkOutOfStoreSymlink "${config.home.homeDirectory}/.config/mozilla/firefox";
        };
      })

      # 视频：mpv 作为默认播放器，Celluloid 也读取现有 mpv Dotfile。
      {
        home.packages = with pkgs; [
          mpv
          celluloid
          # Celluloid 和其他媒体程序共用。
          gst_all_1.gst-plugins-base
          gst_all_1.gst-plugins-good
          gst_all_1.gst-libav
        ];
        xdg.mimeApps.defaultApplications = {
          "video/mp4" = [ "mpv.desktop" ];
          "video/webm" = [ "mpv.desktop" ];
          "video/x-matroska" = [ "mpv.desktop" ];
          "video/avi" = [ "mpv.desktop" ];
          "video/quicktime" = [ "mpv.desktop" ];
        };
        dconf.settings."io/github/celluloid-player/celluloid" = {
          mpv-config-enable = true;
          mpv-config-file = "file://${config.xdg.configHome}/mpv/config";
        };
      }

      # 图片：安装与默认关联一起维护。
      {
        home.packages = [ pkgs.imv ];
        xdg.mimeApps.defaultApplications = {
          "image/png" = [ "imv.desktop" ];
          "image/jpeg" = [ "imv.desktop" ];
          "image/gif" = [ "imv.desktop" ];
          "image/webp" = [ "imv.desktop" ];
          "image/bmp" = [ "imv.desktop" ];
          "image/tiff" = [ "imv.desktop" ];
          "image/svg+xml" = [ "imv.desktop" ];
        };
      }

      # VS Code：文件关联与 Dux 可写主题扩展随应用一起维护。
      (let
        dmsVsix = pkgs.fetchurl {
          name = "dms-theme-0.0.3.vsix";
          url = "https://raw.githubusercontent.com/duxlabs-dev/dux-shell/9b413296b16721f7679fb62e624cb1ed2433fa58/quickshell/matugen/dms-theme.vsix";
          hash = "sha256-MI1x1wiqvwg/N89oMuNVp0qlRT84ubvuMjtpkX0WKQY=";
        };
        codeThemeSettings = pkgs.writeText "dms-vscode-settings.json" (builtins.toJSON {
          "workbench.colorTheme" = "Dynamic Base16 DankShell";
        });
      in {
        home.packages = [ pkgs.vscode ];
        xdg.mimeApps.defaultApplications = {
          "application/json" = [ "code.desktop" ];
          "application/x-shellscript" = [ "code.desktop" ];
          "text/x-csrc" = [ "code.desktop" ];
        };
        # Dux 换壁纸时更新扩展内主题，扩展必须安装到可写目录。
        home.activation.dms-vscode-theme = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
          if ! compgen -G "$HOME/.vscode/extensions/danklinux.dms-theme-*" >/dev/null; then
            run ${lib.getExe pkgs.vscode} --install-extension ${dmsVsix}
          fi
          settings="''${XDG_CONFIG_HOME:-$HOME/.config}/Code/User/settings.json"
          if [ ! -e "$settings" ]; then
            run install -Dm644 ${codeThemeSettings} "$settings"
          fi
        '';
      })
    ];
  };
}
